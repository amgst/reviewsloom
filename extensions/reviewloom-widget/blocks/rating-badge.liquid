{% if product %}
<div class="reviewloom-rating-badge" data-product-id="{{ product.id }}"><span class="reviewloom-rating-badge__stars">★★★★★</span><a href="#reviewloom-reviews">Loading reviews...</a></div>
<script>
(() => {
  const badge = document.currentScript.previousElementSibling;
  const link = badge.querySelector('a');
  link.addEventListener('click', (event) => {
    const target = document.querySelector('[data-reviewloom-list]') || document.getElementById('reviewloom-reviews');
    if (target) {
      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  });
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 8000);
  fetch(`/apps/reviewloom/reviews?product_id=${encodeURIComponent(badge.dataset.productId)}`, { signal: controller.signal })
    .then((response) => { if (!response.ok) throw new Error('bad response'); return response.json(); })
    .then((data) => { link.textContent = data.count ? `${data.average} out of 5 · ${data.count} reviews` : 'No reviews yet — be the first'; })
    .catch(() => { link.textContent = 'No reviews yet'; })
    .finally(() => clearTimeout(timeout));
})();
</script>
{% endif %}

{% schema %}
{ "name": "Product rating badge", "target": "section", "settings": [] }
{% endschema %}

<style>
.reviewloom-rating-badge { display: inline-flex; align-items: center; gap: 9px; margin: 8px 0; font: 13px sans-serif; }.reviewloom-rating-badge__stars { color: #d95d39; letter-spacing: 2px; }.reviewloom-rating-badge a { color: #17221d; }
</style>