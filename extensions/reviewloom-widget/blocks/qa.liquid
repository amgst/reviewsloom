{% if product %}
<section class="reviewloom-qa" id="reviewloom-qa" data-product-id="{{ product.id }}">
  <div class="reviewloom-qa__header">
    <div><h2>{{ block.settings.heading }}</h2><p class="reviewloom-qa__summary">Loading questions...</p></div>
    <button class="reviewloom-qa__button" type="button" data-reviewloom-qa-open>Ask a question</button>
  </div>
  <div class="reviewloom-qa__list" data-reviewloom-qa-list></div>
  <form class="reviewloom-qa__form" id="reviewloom-qa-form" data-reviewloom-qa-form hidden>
    <h3>Ask a question</h3>
    <input name="product_name" type="hidden" value="{{ product.title | escape }}">
    <label>Your name <input name="asker" type="text" required></label>
    <label>Email (optional, so we can let you know when it's answered) <input name="email" type="email"></label>
    <label>Your question <textarea name="question" rows="3" required></textarea></label>
    <div><button class="reviewloom-qa__button" type="submit">Submit question</button><button class="reviewloom-qa__cancel" type="button" data-reviewloom-qa-close>Cancel</button></div>
    <p class="reviewloom-qa__form-status" data-reviewloom-qa-status></p>
  </form>
</section>
<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  const productId = root.dataset.productId;
  const list = root.querySelector('[data-reviewloom-qa-list]');
  const summary = root.querySelector('.reviewloom-qa__summary');
  const openButton = root.querySelector('[data-reviewloom-qa-open]');
  const form = root.querySelector('[data-reviewloom-qa-form]');
  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  const controller = new AbortController();
  const timeout = setTimeout(() => controller.abort(), 8000);
  fetch(`/apps/reviewloom/questions?product_id=${encodeURIComponent(productId)}`, { signal: controller.signal })
    .then((response) => { if (!response.ok) throw new Error('bad response'); return response.json(); })
    .then((data) => {
      summary.textContent = data.count ? `${data.count} question${data.count === 1 ? '' : 's'} answered` : 'No questions yet';
      list.innerHTML = data.questions.length ? data.questions.map((item) => `<article><p class="reviewloom-qa__question">Q: ${escapeHtml(item.question)}</p><p class="reviewloom-qa__answer">A: ${escapeHtml(item.answer)}</p></article>`).join('') : '<p>No questions yet. Be the first to ask.</p>';
    })
    .catch(() => { summary.textContent = 'Questions are temporarily unavailable.'; })
    .finally(() => clearTimeout(timeout));
  if (!form) return;
  if (openButton) openButton.addEventListener('click', () => { form.hidden = false; form.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
  root.querySelector('[data-reviewloom-qa-close]').addEventListener('click', () => { form.hidden = true; });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = form.querySelector('[data-reviewloom-qa-status]');
    const submitButton = form.querySelector('button[type="submit"]');
    const submitController = new AbortController();
    const submitTimeout = setTimeout(() => submitController.abort(), 25000);
    submitButton.disabled = true;
    status.textContent = 'Submitting…';
    fetch(`/apps/reviewloom/questions?product_id=${encodeURIComponent(productId)}`, { method: 'POST', body: new FormData(form), signal: submitController.signal })
      .then((response) => response.json())
      .then((result) => { status.textContent = result.error || "Thanks. We'll answer your question soon."; if (!result.error) form.reset(); })
      .catch((error) => { status.textContent = error.name === 'AbortError' ? 'This is taking longer than expected. Please try again in a moment.' : 'Something went wrong submitting your question. Please try again.'; })
      .finally(() => { clearTimeout(submitTimeout); submitButton.disabled = false; });
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "Questions & answers",
  "target": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Questions & answers" }
  ]
}
{% endschema %}

<style>
.reviewloom-qa { --reviewloom-coral: #d95d39; --reviewloom-ink: #17221d; color: var(--reviewloom-ink); max-width: 760px; margin: 40px auto; font-family: Georgia, serif; }
.reviewloom-qa__header { display: flex; justify-content: space-between; align-items: end; gap: 20px; border-bottom: 1px solid #ddd4ca; padding-bottom: 14px; }
.reviewloom-qa h2, .reviewloom-qa h3 { margin: 0; }
.reviewloom-qa__summary, .reviewloom-qa__form, .reviewloom-qa__form input, .reviewloom-qa__form textarea { font-family: sans-serif; }
.reviewloom-qa__list article { border-bottom: 1px solid #eee8e1; padding: 18px 0; font: 15px/1.5 sans-serif; }
.reviewloom-qa__question { font-weight: 600; margin: 0; }
.reviewloom-qa__answer { margin: 8px 0 0; color: #46524a; }
.reviewloom-qa__button { border: 0; background: var(--reviewloom-coral); color: white; padding: 11px 16px; cursor: pointer; }
.reviewloom-qa__cancel { border: 0; background: transparent; padding: 11px 16px; cursor: pointer; }
.reviewloom-qa__form { background: #f5f0e8; padding: 20px; margin-top: 24px; }
.reviewloom-qa__form label { display: block; margin-top: 12px; }
.reviewloom-qa__form input, .reviewloom-qa__form textarea { display: block; box-sizing: border-box; margin-top: 5px; padding: 10px; width: 100%; border: 1px solid #d9d0c5; background: white; }
</style>
