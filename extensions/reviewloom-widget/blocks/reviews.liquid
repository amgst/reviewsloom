{% if product %}
<section class="reviewloom-reviews reviewloom-reviews--{{ block.settings.layout }}" id="reviewloom-reviews" data-product-id="{{ product.id }}" data-layout="{{ block.settings.layout }}">
  {% if block.settings.layout == 'showcase' %}
    <div class="reviewloom-reviews__title-band"><h2>Ratings &amp; Reviews of {{ product.title }}</h2></div>
    <div class="reviewloom-reviews__summary-card">
      <div class="reviewloom-reviews__score" data-reviewloom-summary>Loading…</div>
      <div class="reviewloom-reviews__bars" data-reviewloom-bars></div>
    </div>
    <div class="reviewloom-reviews__toolbar">
      <h3>Product Reviews</h3>
      <div class="reviewloom-reviews__toolbar-controls">
        {% if block.settings.show_form %}<button class="reviewloom-reviews__button" type="button" data-reviewloom-open>Write a review</button>{% endif %}
        <label>Sort:
          <select data-reviewloom-sort>
            <option value="relevance">Relevance</option>
            <option value="newest">Newest</option>
            <option value="highest">Highest rated</option>
            <option value="lowest">Lowest rated</option>
          </select>
        </label>
        <label>Filter:
          <select data-reviewloom-filter>
            <option value="">All star</option>
            <option value="5">5 star</option>
            <option value="4">4 star</option>
            <option value="3">3 star</option>
            <option value="2">2 star</option>
            <option value="1">1 star</option>
          </select>
        </label>
      </div>
    </div>
    <div class="reviewloom-reviews__list" data-reviewloom-list></div>
    <nav class="reviewloom-reviews__pagination" data-reviewloom-pagination></nav>
  {% else %}
    <div class="reviewloom-reviews__header">
      <div><h2>{{ block.settings.heading }}</h2><p class="reviewloom-reviews__summary" data-reviewloom-summary>Loading reviews...</p></div>
      {% if block.settings.show_form %}<button class="reviewloom-reviews__button" type="button" data-reviewloom-open>Write a review</button>{% endif %}
    </div>
    <div class="reviewloom-reviews__list" data-reviewloom-list></div>
  {% endif %}
  {% if block.settings.show_form %}
    <form class="reviewloom-reviews__form" id="reviewloom-form" data-reviewloom-form hidden>
      <h3>Share your experience</h3>
      <input name="product_name" type="hidden" value="{{ product.title | escape }}">
      <label>Rating <select name="rating" required data-reviewloom-rating-field><option value="5">★★★★★</option><option value="4">★★★★</option><option value="3">★★★</option><option value="2">★★</option><option value="1">★</option></select></label>
      <label>Your name <input name="reviewer" type="text" required></label>
      <label>Email <input name="email" type="email"></label>
      <label>Your review <textarea name="body" rows="4" required></textarea></label>
      <label>Photo URLs (optional, one per line) <textarea name="image_url_lines" rows="2" placeholder="https://example.com/photo1.jpg"></textarea></label>
      <div><button class="reviewloom-reviews__button" type="submit">Submit for review</button><button class="reviewloom-reviews__cancel" type="button" data-reviewloom-close>Cancel</button></div>
      <p class="reviewloom-reviews__form-status" data-reviewloom-status></p>
    </form>
  {% endif %}
</section>
<script>
(() => {
  const root = document.currentScript.previousElementSibling;
  const productId = root.dataset.productId;
  const showcase = root.dataset.layout === 'showcase';
  const list = root.querySelector('[data-reviewloom-list]');
  const summary = root.querySelector('[data-reviewloom-summary]');
  const bars = root.querySelector('[data-reviewloom-bars]');
  const pagination = root.querySelector('[data-reviewloom-pagination]');
  const sortField = root.querySelector('[data-reviewloom-sort]');
  const filterField = root.querySelector('[data-reviewloom-filter]');
  const openButton = root.querySelector('[data-reviewloom-open]');
  const form = root.querySelector('[data-reviewloom-form]');
  const ratingField = root.querySelector('[data-reviewloom-rating-field]');
  const stars = (rating, outline) => `<span class="reviewloom-reviews__stars">${'★'.repeat(rating)}<span>${(outline ? '☆' : '★').repeat(5 - rating)}</span></span>`;
  const escapeHtml = (value) => String(value).replace(/[&<>"']/g, (char) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[char]));
  let outlineStars = false;
  const state = { sort: 'relevance', star: '', page: 1 };

  const votedKey = (id) => `reviewloom-voted-${id}`;
  const renderVotes = (review) => {
    const voted = window.localStorage ? window.localStorage.getItem(votedKey(review.id)) : null;
    return `<button type="button" class="reviewloom-reviews__helpful" data-review-id="${review.id}" ${voted ? 'disabled' : ''}>👍 Helpful (<span data-count>${review.helpfulCount || 0}</span>)</button>`;
  };

  const renderPhotos = (images) => images && images.length
    ? `<div class="reviewloom-reviews__photos">${images.map((url) => `<img src="${escapeHtml(url)}" alt="" loading="lazy">`).join('')}</div>`
    : '';

  const renderList = (reviews) => {
    if (!reviews.length) return '<p class="reviewloom-reviews__empty">No reviews yet. Be the first to share your experience.</p>';
    if (!showcase) {
      return reviews.map((review) => `<article><div>${stars(review.rating, outlineStars)} <strong>${escapeHtml(review.reviewer)}</strong></div><p>${escapeHtml(review.body)}</p></article>`).join('');
    }
    return reviews.map((review) => `<article class="reviewloom-reviews__card">
      ${stars(review.rating, outlineStars)}
      <div class="reviewloom-reviews__card-meta"><strong>${escapeHtml(review.reviewer)}</strong><time>${new Date(review.createdAt).toLocaleDateString()}</time></div>
      <p>${escapeHtml(review.body)}</p>
      ${renderPhotos(review.images)}
      ${renderVotes(review)}
    </article>`).join('');
  };

  const renderPagination = (data) => {
    if (!pagination) return;
    if (data.totalPages <= 1) { pagination.innerHTML = ''; return; }
    const pages = [];
    for (let i = 1; i <= data.totalPages; i += 1) {
      if (i === 1 || i === data.totalPages || Math.abs(i - data.page) <= 1) pages.push(i);
      else if (pages[pages.length - 1] !== '…') pages.push('…');
    }
    const button = (label, targetPage, disabled, active) => `<button type="button" ${disabled ? 'disabled' : ''} ${targetPage ? `data-page="${targetPage}"` : ''} class="${active ? 'is-active' : ''}">${label}</button>`;
    pagination.innerHTML = button('‹', data.page - 1, data.page <= 1) +
      pages.map((p) => (p === '…' ? '<span class="reviewloom-reviews__ellipsis">…</span>' : button(p, p, false, p === data.page))).join('') +
      button('›', data.page + 1, data.page >= data.totalPages);
    pagination.querySelectorAll('button[data-page]').forEach((btn) => btn.addEventListener('click', () => { state.page = Number(btn.dataset.page); load(); }));
  };

  const bindVotes = () => {
    list.querySelectorAll('.reviewloom-reviews__helpful').forEach((button) => {
      button.addEventListener('click', () => {
        if (button.disabled) return;
        const reviewId = button.dataset.reviewId;
        button.disabled = true;
        fetch(`/apps/reviewloom/reviews?product_id=${encodeURIComponent(productId)}`, { method: 'POST', body: new URLSearchParams({ intent: 'vote', review_id: reviewId, vote: 'up' }) })
          .then((response) => response.json())
          .then((result) => {
            if (result.error) { button.disabled = false; return; }
            button.querySelector('[data-count]').textContent = result.helpfulCount;
            if (window.localStorage) window.localStorage.setItem(votedKey(reviewId), '1');
          });
      });
    });
  };

  const load = () => {
    const params = new URLSearchParams({ product_id: productId });
    if (showcase) {
      params.set('sort', state.sort);
      params.set('page', state.page);
      if (state.star) params.set('star', state.star);
    }
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 8000);
    fetch(`/apps/reviewloom/reviews?${params.toString()}`, { signal: controller.signal })
      .then((response) => { if (!response.ok) throw new Error('bad response'); return response.json(); })
      .then((data) => {
        const settings = data.settings || {};
        outlineStars = settings.starStyle === 'outline';
        if (settings.accentColor) root.style.setProperty('--reviewloom-coral', settings.accentColor);
        if (settings.reviewFormOn === false) {
          if (openButton) openButton.hidden = true;
          if (form) form.hidden = true;
        }
        if (showcase) {
          summary.innerHTML = `<div class="reviewloom-reviews__score-number">${data.average}<span>/5</span></div>${stars(Math.round(data.average || 0), outlineStars)}<p>${data.count} Rating${data.count === 1 ? '' : 's'}</p>`;
          if (bars) bars.innerHTML = data.distribution.map((row) => `<div class="reviewloom-reviews__bar-row"><span>${stars(row.stars, outlineStars)}</span><span class="reviewloom-reviews__bar"><span style="width:${data.count ? (row.count / data.count) * 100 : 0}%"></span></span><span>${row.count}</span></div>`).join('');
          renderPagination(data);
        } else {
          summary.innerHTML = `${stars(Math.round(data.average || 0), outlineStars)} ${data.average} out of 5 · ${data.count} reviews`;
        }
        list.innerHTML = renderList(data.reviews);
        bindVotes();
      })
      .catch(() => { summary.textContent = 'Reviews are temporarily unavailable.'; })
      .finally(() => clearTimeout(timeout));
  };

  load();

  if (sortField) sortField.addEventListener('change', () => { state.sort = sortField.value; state.page = 1; load(); });
  if (filterField) filterField.addEventListener('change', () => { state.star = filterField.value; state.page = 1; load(); });

  if (!form) return;
  if (openButton) openButton.addEventListener('click', () => { form.hidden = false; form.scrollIntoView({ behavior: 'smooth', block: 'center' }); });
  root.querySelector('[data-reviewloom-close]').addEventListener('click', () => { form.hidden = true; });
  form.addEventListener('submit', (event) => {
    event.preventDefault();
    const status = form.querySelector('[data-reviewloom-status]');
    const submitButton = form.querySelector('button[type="submit"]');
    const controller = new AbortController();
    const timeout = setTimeout(() => controller.abort(), 25000);
    submitButton.disabled = true;
    status.textContent = 'Submitting…';
    const body = new FormData(form);
    const imageLines = (body.get('image_url_lines') || '').split('\n').map((line) => line.trim()).filter(Boolean);
    body.delete('image_url_lines');
    imageLines.forEach((line) => body.append('image_url', line));
    fetch(`/apps/reviewloom/reviews?product_id=${encodeURIComponent(productId)}`, { method: 'POST', body, signal: controller.signal })
      .then((response) => response.json())
      .then((result) => { status.textContent = result.error || 'Thanks. Your review is waiting for approval.'; if (!result.error) { form.reset(); state.page = 1; load(); } })
      .catch((error) => { status.textContent = error.name === 'AbortError' ? 'This is taking longer than expected. Please try again in a moment.' : 'Something went wrong submitting your review. Please try again.'; })
      .finally(() => { clearTimeout(timeout); submitButton.disabled = false; });
  });
})();
</script>
{% endif %}

{% schema %}
{
  "name": "All product reviews",
  "target": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "default": "list",
      "options": [
        { "value": "list", "label": "Simple list" },
        { "value": "showcase", "label": "Showcase (rating breakdown, sort/filter, photos)" }
      ]
    },
    { "type": "text", "id": "heading", "label": "Heading (simple list layout)", "default": "What customers are saying" },
    { "type": "checkbox", "id": "show_form", "label": "Allow new reviews", "default": true }
  ]
}
{% endschema %}

<style>
.reviewloom-reviews { --reviewloom-coral: #d95d39; --reviewloom-ink: #17221d; color: var(--reviewloom-ink); max-width: 760px; margin: 40px auto; font-family: Georgia, serif; }
.reviewloom-reviews--showcase { max-width: 980px; font-family: sans-serif; }
.reviewloom-reviews__header { display: flex; justify-content: space-between; align-items: end; gap: 20px; border-bottom: 1px solid #ddd4ca; padding-bottom: 14px; }
.reviewloom-reviews h2, .reviewloom-reviews h3 { margin: 0; }.reviewloom-reviews__summary, .reviewloom-reviews__form, .reviewloom-reviews__form input, .reviewloom-reviews__form textarea, .reviewloom-reviews__form select { font-family: sans-serif; }
.reviewloom-reviews__stars { color: var(--reviewloom-coral); letter-spacing: 2px; }.reviewloom-reviews__stars span { color: #d7cec4; }
.reviewloom-reviews__list article { border-bottom: 1px solid #eee8e1; padding: 18px 0; }.reviewloom-reviews__list p { margin: 9px 0 0; font: 15px/1.5 sans-serif; }
.reviewloom-reviews__button { border: 0; background: var(--reviewloom-coral); color: white; padding: 11px 16px; cursor: pointer; border-radius: 4px; }.reviewloom-reviews__cancel { border: 0; background: transparent; padding: 11px 16px; cursor: pointer; }
.reviewloom-reviews__form { background: #f5f0e8; padding: 20px; margin-top: 24px; }.reviewloom-reviews__form label { display: block; margin-top: 12px; font-size: 14px; }.reviewloom-reviews__form input, .reviewloom-reviews__form textarea, .reviewloom-reviews__form select { display: block; box-sizing: border-box; margin-top: 5px; padding: 10px; width: 100%; border: 1px solid #d9d0c5; background: white; }

.reviewloom-reviews__title-band { background: #f4f4f6; padding: 14px 20px; border-radius: 8px 8px 0 0; }
.reviewloom-reviews__title-band h2 { font-size: 16px; }
.reviewloom-reviews__summary-card { border: 1px solid #eee8e1; border-top: 0; padding: 24px 20px; display: flex; align-items: center; gap: 48px; flex-wrap: wrap; }
.reviewloom-reviews__score { min-width: 140px; }
.reviewloom-reviews__score-number { font-size: 40px; font-weight: 700; line-height: 1; }
.reviewloom-reviews__score-number span { font-size: 18px; color: #6b6258; font-weight: 400; }
.reviewloom-reviews__score p { margin: 6px 0 0; font-size: 13px; color: #6b6258; }
.reviewloom-reviews__bars { flex: 1; min-width: 220px; }
.reviewloom-reviews__bar-row { display: grid; grid-template-columns: 70px 1fr 34px; align-items: center; gap: 10px; font-size: 13px; margin-bottom: 6px; }
.reviewloom-reviews__bar-row .reviewloom-reviews__stars { font-size: 13px; }
.reviewloom-reviews__bar { background: #eee8e1; border-radius: 4px; height: 8px; overflow: hidden; }
.reviewloom-reviews__bar span { display: block; height: 100%; background: var(--reviewloom-coral); }
.reviewloom-reviews__toolbar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; padding: 18px 4px; border-bottom: 1px solid #eee8e1; }
.reviewloom-reviews__toolbar h3 { font-size: 16px; }
.reviewloom-reviews__toolbar-controls { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; font-size: 13px; color: #6b6258; }
.reviewloom-reviews__toolbar-controls select { border: 1px solid #d9d0c5; border-radius: 4px; padding: 5px 8px; }
.reviewloom-reviews--showcase .reviewloom-reviews__list article { border-bottom: 1px solid #eee8e1; padding: 20px 4px; }
.reviewloom-reviews__card-meta { display: flex; align-items: center; gap: 10px; margin: 6px 0 4px; font-size: 13px; color: #6b6258; }
.reviewloom-reviews__photos { display: flex; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
.reviewloom-reviews__photos img { width: 72px; height: 72px; object-fit: cover; border-radius: 6px; border: 1px solid #eee8e1; }
.reviewloom-reviews__helpful { margin-top: 10px; border: 1px solid #eee8e1; background: white; border-radius: 6px; padding: 6px 12px; font-size: 13px; cursor: pointer; }
.reviewloom-reviews__helpful:disabled { opacity: 0.55; cursor: default; }
.reviewloom-reviews__empty { padding: 24px 4px; color: #6b6258; }
.reviewloom-reviews__pagination { display: flex; justify-content: center; gap: 6px; padding: 24px 0; flex-wrap: wrap; }
.reviewloom-reviews__pagination button { min-width: 32px; height: 32px; border: 1px solid #eee8e1; background: white; border-radius: 6px; cursor: pointer; font-size: 13px; }
.reviewloom-reviews__pagination button.is-active { background: var(--reviewloom-ink); color: white; border-color: var(--reviewloom-ink); }
.reviewloom-reviews__pagination button:disabled { opacity: 0.4; cursor: default; }
.reviewloom-reviews__ellipsis { padding: 0 4px; align-self: center; color: #918878; }
@media (max-width: 700px) { .reviewloom-reviews__summary-card { flex-direction: column; align-items: flex-start; gap: 20px; } }
</style>
