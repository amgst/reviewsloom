# Shopify Partner app credentials
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=https://your-app-url.example.com
SCOPES=read_products,write_products,read_orders,write_themes
# SHOP_CUSTOM_DOMAIN=your-shop.myshopify.com

# Postgres connection (e.g. Supabase, Vercel Postgres / Neon)
# DATABASE_URL must include pgbouncer=true when pointed at a transaction-mode
# pooler (e.g. Supabase's port 6543) - otherwise Prisma's prepared statements
# collide across pooled connections ("prepared statement already exists").
DATABASE_URL=postgresql://user:password@host:6543/db?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/db
