// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Review {
  id              String        @id @default(cuid())
  shop            String
  productId       String
  productName     String
  reviewer        String
  rating          Int
  body            String
  imageUrl        String?
  status          String        @default("PENDING")
  helpfulCount    Int           @default(0)
  notHelpfulCount Int           @default(0)
  discountCode    String?
  source          String        @default("storefront")
  importKey       String?       @unique
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  images          ReviewImage[]
  events          ReviewEvent[]
  votes           ReviewVote[]

  @@index([shop, productId, status])
  @@index([shop, deletedAt, createdAt])
  @@index([shop, status, createdAt])
}

model ReviewEvent {
  id        String   @id @default(cuid())
  shop      String
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  action    String
  createdAt DateTime @default(now())

  @@index([shop, reviewId, createdAt])
}

model ReviewImage {
  id            String  @id @default(cuid())
  reviewId      String
  review        Review  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url           String
  shopifyFileId String?
  position      Int     @default(0)

  @@index([reviewId])
}

model ReviewSettings {
  id                    String    @id @default(cuid())
  shop                  String    @unique
  accentColor           String    @default("#D95D39")
  starStyle             String    @default("solid")
  alignment             String    @default("center")
  reviewFormOn          Boolean   @default(true)
  customerEligibility   String    @default("everyone")
  autoPublishThreshold  String    @default("disabled")
  recycleBinOn          Boolean   @default(false)
  reviewDiscountPercent String    @default("none")
  onboardingCompletedAt DateTime?
  widgetSeenAt          DateTime?
  setupThemeConfirmedAt DateTime?
}

model StorefrontRateLimit {
  key       String   @id
  count     Int      @default(1)
  expiresAt DateTime

  @@index([expiresAt])
}

model ReviewVote {
  id        String   @id @default(cuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  voterKey  String
  createdAt DateTime @default(now())

  @@unique([reviewId, voterKey])
  @@index([createdAt])
}

model Question {
  id          String    @id @default(cuid())
  shop        String
  productId   String
  productName String
  question    String
  asker       String
  answer      String?
  answeredAt  DateTime?
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([shop, createdAt])
}
